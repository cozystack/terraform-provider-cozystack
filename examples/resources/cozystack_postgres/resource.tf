resource "cozystack_postgres" "app" {
  name      = "app"
  namespace = "tenant-root"

  replicas = 2
  version  = "v18"
  size     = "20Gi"
  tls      = { enabled = true }

  backup = { use_system_bucket = true }

  # Passwords are generated by the platform and kept in the
  # postgres-app-credentials Secret.
  users = {
    app = {}
  }
  databases = {
    appdb = {
      extensions = ["postgis"]
      roles      = { admin = ["app"] }
    }
  }

  # The connection endpoints are published asynchronously, so without waiting
  # they are only readable from the apply after the one that created the cluster.
  wait_for_ready = true
}
