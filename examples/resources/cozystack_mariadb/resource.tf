resource "cozystack_mariadb" "app" {
  name      = "app"
  namespace = "tenant-root"

  replicas = 2
  version  = "v11.8"
  size     = "20Gi"

  # Passwords are generated by the platform and kept in the
  # mariadb-app-credentials Secret.
  users = {
    app = { max_user_connections = 100 }
  }
  databases = {
    appdb = { roles = { admin = ["app"] } }
  }
}
