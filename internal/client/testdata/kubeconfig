apiVersion: v1
kind: Config
clusters:
  - name: test-cluster
    cluster:
      server: https://api.example.test:6443
      insecure-skip-tls-verify: true
  - name: other-cluster
    cluster:
      server: https://other.example.test:6443
      insecure-skip-tls-verify: true
contexts:
  - name: test-context
    context:
      cluster: test-cluster
      user: test-user
  - name: other-context
    context:
      cluster: other-cluster
      user: test-user
current-context: test-context
users:
  - name: test-user
    user:
      token: testdata-token
